# 依赖目录
node_modules/
.pnpm-store/

# VitePress 构建产物与缓存（构建后自动生成，不要提交）
content/.vitepress/dist/
content/.vitepress/cache/

# 本地环境变量（从 .env.example 复制而来，含个人配置，不要提交）
docker/.env
.env
.env.local

# 私密文档区：技术文摘 / 过程纪要 / 开发日记 / 公众号草稿等
# content/ 是会被构建并公开的目录，私密内容放这里，整目录不提交
# （后续若想给它单独做私有 git 仓库，直接在本目录 git init 即可，父仓库看不见）
private/

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# 系统文件
.DS_Store
Thumbs.db

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 临时文件
*.tmp
dist/
