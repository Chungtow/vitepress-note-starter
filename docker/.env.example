# =============================================================================
# 复制为 .env 后按需修改：cp .env.example .env
# 注意：docker compose 会自动读取与本文件同目录的 .env，无需额外指定 --env-file
# .env 已在 .gitignore 中忽略，不会提交到仓库
# =============================================================================

# 访问端口：宿主机 http://localhost:<DEV_PORT>
# 5173 被占用时改成 5174 / 8080 等
DEV_PORT=5173

# 镜像名称与容器名（同一台机器同时开多个笔记站点时改成不同的值）
IMAGE_NAME=vitepress-note-starter-dev
CONTAINER_NAME=vitepress-note-dev

# pnpm 版本（需与 package.json 的 packageManager 保持一致）
PNPM_VERSION=10.34.9

# npm registry：国内建议保留 npmmirror，公司内网有私有源时改成自己的地址
NPM_REGISTRY=https://registry.npmmirror.com
